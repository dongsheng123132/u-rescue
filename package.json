{
  "name": "u-rescue",
  "version": "0.1.0",
  "description": "AI 编程工具（Codex / Claude Code）环境故障病例与解决方案库。只读诊断，方案可回滚可验证。",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "u-rescue": "./bin/u-rescue.mjs" },
  "engines": { "node": ">=18" },
  "files": ["bin/", "lib/", "cases/", "schema/", "README.md", "LICENSE"],
  "scripts": {
    "doctor": "node bin/u-rescue.mjs doctor",
    "validate": "node scripts/validate.mjs",
    "harvest": "node scripts/harvest.mjs",
    "build:index": "node scripts/build-index.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:skill": "node scripts/build-skill.mjs",
    "build:uking": "node scripts/build-uking-feed.mjs",
    "build": "npm run validate && npm run build:index && npm run build:site && npm run build:skill && npm run build:uking",
    "test": "node scripts/validate.mjs && node scripts/smoke.mjs"
  },
  "keywords": ["codex", "claude-code", "troubleshooting", "诊断", "急救", "AI工具"],
  "repository": { "type": "git", "url": "https://github.com/dongsheng123132/u-rescue.git" },
  "dependencies": {}
}
